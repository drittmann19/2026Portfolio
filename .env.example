# ─────────────────────────────────────────────────────────────
# TEMPLATE — safe to commit. Copy this to .env.local and fill in
# real values there. Never put real secrets in this file.
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# Anthropic API key. Create one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Kill switch: "true" enables the JD evaluator, "false" disables it.
EVALUATOR_ENABLED=true

# Upstash Redis (rate limiting). Create a free DB at console.upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
